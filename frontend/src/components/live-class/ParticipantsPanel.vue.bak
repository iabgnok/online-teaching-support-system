<template>
  <div class="participants-panel" :class="{ visible: visible }">
    <!-- 闈㈡澘澶撮儴 -->
    <div class="panel-header">
      <h3>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        鍙備笌鑰?
        <span class="count-badge">{{ participants.length }}</span>
      </h3>
      <button class="close-btn" @click="$emit('close')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    
    <!-- 鎼滅储鏍?-->
    <div class="search-bar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        v-model="searchQuery"
        placeholder="鎼滅储鍙備笌鑰?.."
      />
    </div>
    
    <!-- 鏁欏笀鍖哄煙 -->
    <div class="section" v-if="teachers.length > 0">
      <div class="section-title">
        <span class="title-icon teacher-icon">馃懆鈥嶐煆?/span>
        鏁欏笀 ({{ teachers.length }})
      </div>
      <div class="participants-list">
        <div 
          v-for="teacher in teachers" 
          :key="teacher.id"
          class="participant-item teacher"
        >
          <div class="avatar">
            <img v-if="teacher.avatar" :src="teacher.avatar" :alt="teacher.name" />
            <span v-else class="avatar-text">{{ getInitial(teacher.name) }}</span>
            <span class="status-dot" :class="{ online: teacher.online }"></span>
          </div>
          <div class="info">
            <div class="name">{{ teacher.name }}</div>
            <div class="role">{{ teacher.role_name || '鏁欏笀' }}</div>
          </div>
          <div class="badges">
            <span class="badge host" v-if="teacher.is_host">涓绘寔浜?/span>
            <span class="badge sharing" v-if="teacher.is_sharing">鍏变韩涓?/span>
          </div>
        </div>
      </div>
    </div>
    
    <!-- 瀛︾敓鍖哄煙 -->
    <div class="section" v-if="filteredStudents.length > 0">
      <div class="section-title">
        <span class="title-icon student-icon">馃懆鈥嶐煄?/span>
        瀛︾敓 ({{ filteredStudents.length }})
      </div>
      <div class="participants-list">
        <div 
          v-for="student in filteredStudents" 
          :key="student.id"
          class="participant-item"
          :class="{ 'hand-raised': student.hand_raised }"
        >
          <div class="avatar">
            <img v-if="student.avatar" :src="student.avatar" :alt="student.name" />
            <span v-else class="avatar-text">{{ getInitial(student.name) }}</span>
            <span class="status-dot" :class="{ online: student.online }"></span>
          </div>
          <div class="info">
            <div class="name">
              {{ student.name }}
              <span v-if="student.hand_raised" class="hand-icon" title="宸蹭妇鎵?>鉁?/span>
            </div>
            <div class="status-text">
              <span v-if="student.online">鍦ㄧ嚎</span>
              <span v-else class="offline">绂荤嚎</span>
              <span v-if="student.join_time" class="join-time">
                路 {{ formatJoinTime(student.join_time) }}
              </span>
            </div>
          </div>
          
          <!-- 鏁欏笀涓撶敤鎿嶄綔 -->
          <div class="actions" v-if="role === 'teacher' && student.online">
            <button 
              class="action-btn" 
              @click="allowSpeak(student)"
              :title="student.can_speak ? '绂佽█' : '鍏佽鍙戣█'"
            >
              <svg v-if="student.can_speak" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                <line x1="12" y1="19" x2="12" y2="23"></line>
                <line x1="8" y1="23" x2="16" y2="23"></line>
              </svg>
              <svg v-else width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="1" y1="1" x2="23" y2="23"></line>
                <path d="M9 9v3a3 3 0 0 0 5.12 2.12M15 9.34V4a3 3 0 0 0-5.94-.6"></path>
                <path d="M17 16.95A7 7 0 0 1 5 12v-2m14 0v2a7 7 0 0 1-.11 1.23"></path>
                <line x1="12" y1="19" x2="12" y2="23"></line>
                <line x1="8" y1="23" x2="16" y2="23"></line>
              </svg>
            </button>
            
            <button 
              class="action-btn" 
              @click="focusStudent(student)"
              title="鑱氱劍璇ュ鐢?
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 2v4m0 12v4M2 12h4m12 0h4"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
    
    <!-- 绌虹姸鎬?-->
    <div class="empty-state" v-if="filteredParticipants.length === 0">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
      <p v-if="searchQuery">鏈壘鍒板尮閰嶇殑鍙備笌鑰?/p>
      <p v-else>鏆傛棤鍙備笌鑰呭姞鍏?/p>
    </div>
    
    <!-- 涓炬墜鍒楄〃锛堟暀甯堣瑙掞級 -->
    <div class="raised-hands-section" v-if="role === 'teacher' && raisedHands.length > 0">
      <div class="section-title raised-hands-title">
        <span class="title-icon">鉁?/span>
        涓炬墜涓?({{ raisedHands.length }})
      </div>
      <div class="raised-hands-list">
        <div 
          v-for="student in raisedHands" 
          :key="student.id"
          class="raised-hand-item"
        >
          <span class="student-name">{{ student.name }}</span>
          <div class="raised-hand-actions">
            <button class="allow-btn" @click="answerStudent(student)">
              鍥炲簲
            </button>
            <button class="dismiss-btn" @click="dismissHand(student)">
              鍙栨秷
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { ref, computed } from 'vue'

export default {
  name: 'ParticipantsPanel',
  props: {
    visible: {
      type: Boolean,
      default: false
    },
    participants: {
      type: Array,
      default: () => []
    },
    role: {
      type: String,
      default: 'student',
      validator: (value) => ['teacher', 'student'].includes(value)
    }
  },
  emits: [
    'close',
    'allow-speak',
    'focus-student',
    'answer-student',
    'dismiss-hand'
  ],
  setup(props, { emit }) {
    const searchQuery = ref('')
    
    // 鍒嗙鏁欏笀鍜屽鐢?
    const teachers = computed(() => {
      return props.participants.filter(p => p.role === 'teacher')
    })
    
    const students = computed(() => {
      return props.participants.filter(p => p.role === 'student')
    })
    
    // 鎼滅储杩囨护
    const filteredStudents = computed(() => {
      if (!searchQuery.value) return students.value
      const query = searchQuery.value.toLowerCase()
      return students.value.filter(s => 
        s.name.toLowerCase().includes(query)
      )
    })
    
    const filteredParticipants = computed(() => {
      return [...teachers.value, ...filteredStudents.value]
    })
    
    // 涓炬墜瀛︾敓
    const raisedHands = computed(() => {
      return students.value.filter(s => s.hand_raised).sort((a, b) => {
        return new Date(a.hand_raised_at) - new Date(b.hand_raised_at)
      })
    })
    
    // 鑾峰彇濮撳悕棣栧瓧姣?
    const getInitial = (name) => {
      if (!name) return '?'
      return name.charAt(0).toUpperCase()
    }
    
    // 鏍煎紡鍖栧姞鍏ユ椂闂?
    const formatJoinTime = (time) => {
      if (!time) return ''
      const date = new Date(time)
      const now = new Date()
      const diff = Math.floor((now - date) / 1000 / 60) // 鍒嗛挓
      
      if (diff < 1) return '鍒氬垰鍔犲叆'
      if (diff < 60) return `${diff}鍒嗛挓鍓峘
      const hours = Math.floor(diff / 60)
      if (hours < 24) return `${hours}灏忔椂鍓峘
      return date.toLocaleDateString()
    }
    
    // 鎿嶄綔鏂规硶
    const allowSpeak = (student) => {
      emit('allow-speak', student)
    }
    
    const focusStudent = (student) => {
      emit('focus-student', student)
    }
    
    const answerStudent = (student) => {
      emit('answer-student', student)
    }
    
    const dismissHand = (student) => {
      emit('dismiss-hand', student)
    }
    
    return {
      searchQuery,
      teachers,
      filteredStudents,
      filteredParticipants,
      raisedHands,
      getInitial,
      formatJoinTime,
      allowSpeak,
      focusStudent,
      answerStudent,
      dismissHand
    }
  }
}
</script>

